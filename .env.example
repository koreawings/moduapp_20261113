# Copy this file to .env.local and fill the values from Supabase.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# PostgreSQL persistence. Empty means local SQLite; a failed connection never falls back.
# Use the Connect panel's session pooler URL on IPv4, with the dedicated role:
# postgresql://kj_trail_backend.PROJECT_REF:PERCENT_ENCODED_PASSWORD@POOLER_HOST:5432/postgres
DATABASE_URL=
# Optional Supabase root CA certificate path; TLS verifies the server by default.
DATABASE_SSL_CA=certs/supabase-ca.crt
