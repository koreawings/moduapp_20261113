{
  "name": "kj-trail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --configLoader native --host 127.0.0.1",
    "dev:server": "node server/index.mjs",
    "build": "tsc -b && vite build --configLoader native",
    "typecheck": "tsc -b",
    "test": "node --test tests/*.test.mjs",
    "test:postgres": "node --test server/postgres.test.mjs",
    "verify": "node scripts/verify.mjs",
    "start": "node server/index.mjs",
    "grant-admin": "node server/cli.mjs grant-admin",
    "turnkey": "node scripts/turnkey.mjs"
  },
  "dependencies": {
    "@vercel/functions": "3.11.2",
    "lucide-react": "^0.468.0",
    "pg": "8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  }
}
