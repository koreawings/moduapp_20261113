{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm exec --yes --package=pnpm@11.25.0 -- pnpm install --frozen-lockfile",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "env": { "NODEJS_HELPERS": "0" },
  "build": { "env": { "NODEJS_HELPERS": "0" } },
  "functions": {
    "api/index.js": {
      "includeFiles": "certs/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api(?:/|$)|assets(?:/|$))[^.]*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" }
      ]
    }
  ]
}
